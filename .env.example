# Public browser configuration (safe to expose to the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only secret used by /api/progress and /api/client-errors.
# Never prefix this variable with NEXT_PUBLIC and never commit its real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
