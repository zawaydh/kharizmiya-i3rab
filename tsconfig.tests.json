{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "content/**/*.ts",
    "data/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
